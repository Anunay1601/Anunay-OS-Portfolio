# ==============================================================================
# ANUNAY OS Environment Variables
# ==============================================================================

# Resend API Key
# Obtain from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Sender Address
# In development / testing without a custom domain, Resend requires onboarding@resend.dev
# After adding and verifying your domain in Resend, you can use: ANUNAY OS <contact@yourdomain.com>
RESEND_FROM_EMAIL=ANUNAY OS <onboarding@resend.dev>

# Recipient Email
# The email address where portfolio contact messages will be delivered
CONTACT_RECEIVER_EMAIL=anunaychhapre@gmail.com
